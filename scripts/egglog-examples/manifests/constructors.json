      "id": "proof-extract-cost",
      "source": {
        "path": "tests/proof-extract-cost.egg",
        "sha256": "6ebb3200fc303824afbe379ba0435814f2e2624e39a58494154eb52ace6f733c",
        "url": "https://github.com/egraphs-good/egglog/blob/593df10e1465904e8b7a3dc85d8ef3976842b509/tests/proof-extract-cost.egg",
        "vendored_path": "fixtures/constructors/proof-extract-cost/upstream.egg"
      },
      "classification": "finite-example",
      "adaptations": [
        "Retain constructor costs Cheap=5 and Expensive=100, their union, and extraction; require (Cheap) on stdout.",
        "The cost-swap validation raises Cheap to 200 and requires (Expensive); the missing-equality control omits the union and must reject equality."
      ],
      "limitations": [
        "Only normal-mode weighted extraction is exercised. No proof mode, term encoding, proof objects, or proof-mode cost regression is tested.",
        "The source has extraction rather than an equality assertion; the manifest supplies the output oracle. This tiny fixture is not a separate performance family."
      ],
      "cases": [
        {
          "id": "source",
          "kind": "source",
          "programs": [
            {
              "engine": "egglog",
              "arm": "original",
              "path": "fixtures/constructors/proof-extract-cost/upstream.egg",
              "sha256": "6ebb3200fc303824afbe379ba0435814f2e2624e39a58494154eb52ace6f733c",
              "expected": "pass",
              "stdout_contains": [
                "(Cheap)"
              ]
            },
            {
              "engine": "egglog",
              "arm": "encoded",
              "path": "fixtures/constructors/proof-extract-cost/upstream.egg",
              "sha256": "6ebb3200fc303824afbe379ba0435814f2e2624e39a58494154eb52ace6f733c",
              "expected": "pass",
              "stdout_contains": [
                "(Cheap)"
              ]
            },
            {
              "engine": "ours",
              "arm": "encoded",
              "path": "fixtures/constructors/proof-extract-cost/upstream.egg",
              "sha256": "6ebb3200fc303824afbe379ba0435814f2e2624e39a58494154eb52ace6f733c",
              "expected": "pass",
              "stdout_contains": [
                "(Cheap)"
