    {
      "id": "repro-silly-panic",
      "source": {
        "path": "tests/repro-silly-panic.egg",
        "sha256": "1a106cbeedc9755a20c1dced88cffe2354ecea9ab769b368f2969f4cd275df5e",
        "url": "https://github.com/egraphs-good/egglog/blob/593df10e1465904e8b7a3dc85d8ef3976842b509/tests/repro-silly-panic.egg",
        "vendored_path": "fixtures/constructors/repro-silly-panic/upstream.egg"
      },
      "classification": "finite-example",
      "adaptations": [
        "Preserve the idempotence rewrite, cyclic/shared-root rule, source term, and run 10; alpha-rename globals in the encoded arms.",
        "Use the validated source-with-oracle harness: append the source-term equality on all three arms, while vendoring the exact unaugmented source separately.",
        "Retain a nested-input validation and a premature-equality negative control."
      ],
      "limitations": [
        "The upstream fixture has no final check or extraction. The added source and nested equalities already follow from idempotence, so they do not independently validate the cyclic-query rule.",
        "Successful finite execution and the added equalities do not establish general cyclic-query correctness or a new performance family."
      ],
      "cases": [
        {
          "id": "source-with-oracle",
          "kind": "source",
          "programs": [
