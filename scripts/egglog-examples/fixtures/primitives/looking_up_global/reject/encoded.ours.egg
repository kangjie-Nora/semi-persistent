(datatype NVal (N i64))
(datatype Flag (Present))
(constructor F () NVal)
(constructor G () NVal)
(constructor Known (NVal) Flag)
(rule ((= x (N n))) ((union (Known x) (Present))))
(union (F) (N 0))
(run 1)
(prove (= (Known (F)) (Present)))
(let x (F))
(prove (!= (Known (G)) (Present)))

(prove (= x (N 0)))
(prove (!= (G) (N 0)))
(prove (= (Known (G)) (Present)))
