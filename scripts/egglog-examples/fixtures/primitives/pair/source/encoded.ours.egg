; Adapted from egglog (MIT); see LICENSE.egglog at corpus root.
(datatype NVal (N i64))
(datatype TVal (T String))
(datatype Math (Num i64))
(datatype IntPair (IP i64 i64))
(datatype StrPair (SP i64 String))
(datatype MathPair (MP Math i64))
(constructor FirstI (IntPair) NVal)
(constructor SecondI (IntPair) NVal)
(constructor FirstS (StrPair) NVal)
(constructor SecondS (StrPair) TVal)
(constructor FirstM (MathPair) Math)
(constructor SecondM (MathPair) NVal)
(rewrite (FirstI (IP a b)) (N a))
(rewrite (SecondI (IP a b)) (N b))
(rewrite (FirstS (SP a b)) (N a))
(rewrite (SecondS (SP a b)) (T b))
(rewrite (FirstM (MP a b)) a)
(rewrite (SecondM (MP a b)) (N b))
(let p (IP 1 2))
(FirstI p) (SecondI p) (run 10)
(prove (= (FirstI p) (N 1)))
(prove (= (SecondI p) (N 2)))
(let q (IP 3 4))
(FirstI q) (SecondI q) (run 10)
(prove (= (FirstI q) (N 3)))
(prove (= (SecondI q) (N 4)))
(prove (= p (IP 1 2)))
(prove (!= p q))
(let sp (SP 10 "hello"))
(FirstS sp) (SecondS sp) (run 10)
(prove (= (FirstS sp) (N 10)))
(prove (= (SecondS sp) (T "hello")))
(let a (Num 1)) (let b (Num 2))
(let mp (MP a 42))
(FirstM mp) (SecondM mp) (run 10)
(prove (= (FirstM mp) a))
(prove (= (SecondM mp) (N 42)))
(union a b)
(run 1)
(prove (= (FirstM mp) b))
